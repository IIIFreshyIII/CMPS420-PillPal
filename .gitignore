# Python environments
.venv/
.venv-gpu/
__pycache__/
*.pyc

# Generated training data + model checkpoints (regenerate with the scripts; too big for git)
distill/data/*
# keep the hand-curated real-label eval set in git (gitignore has no inline comments)
!distill/data/real_test.jsonl
distill/data-*/
distill/data_smoke/
distill/ner-model/
distill/ner-mobilebert/
distill/ner-onnx/
distill/model-*/
distill/runs/
distill/run-*.log

# Label images: mock ones regenerate from the script; real ones must never be committed (patient info)
distill/mock_labels/
distill/real_labels/

# Pipeline output
profile.json

# Label photos (never commit real prescription images)
*.jpg
*.jpeg
*.png
!sample_labels/*

# Editor / OS
.vscode/
.idea/
.DS_Store
