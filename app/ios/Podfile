# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_NOTIFICATIONS=1',
      ]
    end
  end
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386'
  end
  installer.aggregate_targets.each do |target|
    target.xcconfigs.each do |config_name, config_file|
      config_file.attributes.delete("EXCLUDED_ARCHS[sdk=iphonesimulator*]")
    end
  end
  Dir.glob(File.join(__dir__, 'Pods', 'Target Support Files', '**', '*.xcconfig')).each do |file|
    content = File.read(file)
    new_content = content.gsub(/EXCLUDED_ARCHS\[sdk=iphonesimulator\*\]\s*=\s*arm64/, 'EXCLUDED_ARCHS[sdk=iphonesimulator*] = i386')
    File.write(file, new_content) if content != new_content
  end

  # Prepare precompiled static frameworks for both physical device (iOS) and Apple Silicon simulator (iOS-simulator)
  prepare_dual_framework_slices = lambda do |framework_binary_path|
    return unless File.exist?(framework_binary_path)

    device_path = "#{framework_binary_path}.device"
    sim_path = "#{framework_binary_path}.simulator"

    # Save initial pristine binary as .device if not already present
    FileUtils.cp(framework_binary_path, device_path) unless File.exist?(device_path)

    info = `lipo -info "#{device_path}" 2>/dev/null`
    return unless info.include?('arm64')

    arm64_path = "#{framework_binary_path}_arm64"
    x86_64_path = "#{framework_binary_path}_x86_64"

    system('lipo', '-thin', 'arm64', device_path, '-output', arm64_path)
    return unless File.exist?(arm64_path)

    has_x86 = info.include?('x86_64')
    system('lipo', '-thin', 'x86_64', device_path, '-output', x86_64_path) if has_x86

    buf = File.binread(arm64_path)
    i = 0
    len = buf.bytesize
    patched = false
    while i <= len - 32
      if buf[i, 4] == "\xCF\xFA\xED\xFE".b
        ncmds = buf[i + 16, 4].unpack1('V')
        cmd_off = i + 32
        ncmds.times do
          break if cmd_off + 8 > len
          cmd = buf[cmd_off, 4].unpack1('V')
          cmdsize = buf[cmd_off + 4, 4].unpack1('V')
          if cmd == 0x32
            platform = buf[cmd_off + 8, 4].unpack1('V')
            if platform == 2
              buf[cmd_off + 8, 4] = [7].pack('V')
              patched = true
            end
          end
          cmd_off += cmdsize
        end
      end
      i += 4
    end

    if patched
      File.binwrite(arm64_path, buf)
      if has_x86 && File.exist?(x86_64_path)
        system('lipo', '-create', arm64_path, x86_64_path, '-output', sim_path)
      else
        FileUtils.cp(arm64_path, sim_path)
      end
    end
    File.delete(arm64_path) if File.exist?(arm64_path)
    File.delete(x86_64_path) if File.exist?(x86_64_path)
  end

  Dir.glob(File.join(__dir__, 'Pods', '**', '*.framework', '*')).each do |bin|
    next if bin.end_with?('.plist') || bin.end_with?('.h') || bin.include?('.framework/_CodeSignature') || bin.end_with?('.device') || bin.end_with?('.simulator') || File.directory?(bin)
    prepare_dual_framework_slices.call(bin)
  end
end