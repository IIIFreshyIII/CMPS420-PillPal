# Flutter / Dart — build outputs and local tooling only.
# Platform folders (android/, ios/, ...) ARE committed once `flutter create .`
# generates them, so camera permissions / notification config are shared.

.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.iml

# Android
android/.gradle/
android/captures/
android/local.properties
android/key.properties
android/app/debug/
android/app/profile/
android/app/release/
**/*.keystore
**/*.jks

# iOS / macOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework/
ios/Flutter/Flutter.podspec
macos/Pods/
**/DerivedData/

# IDE / OS
.idea/
.vscode/
*.log
.DS_Store
